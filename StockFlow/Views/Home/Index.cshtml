@model StockFlow.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Genel Bakış";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Genel Bakış</h2>
            <p class="text-secondary mb-0">
                StockFlow yönetim paneline hoş geldiniz.
            </p>
        </div>

        <span class="badge bg-primary p-2">
            StockFlow Yönetim
        </span>
    </div>

    <!-- İstatistik Kartları -->

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-2">Toplam Ürün</p>
                    <h2 class="fw-bold">@Model.TotalProducts</h2>
                    <span class="text-muted small">Kayıtlı ürün sayısı</span>
                    <div class="mt-3 text-primary fs-3">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-2">Toplam Stok</p>
                    <h2 class="fw-bold">@Model.TotalStockQuantity</h2>
                    <span class="text-muted small">Depodaki toplam miktar</span>
                    <div class="mt-3 text-success fs-3">
                        <i class="bi bi-archive"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-2">Kritik Stok</p>
                    <h2 class="fw-bold text-danger">
                        @Model.CriticalStockCount
                    </h2>
                    <span class="text-muted small">5 ve altındaki ürünler</span>
                    <div class="mt-3 text-danger fs-3">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-2">Stok Değeri</p>
                    <h2 class="fw-bold">
                        @Model.TotalStockValue.ToString("N2") ₺
                    </h2>
                    <span class="text-muted small">Toplam alış maliyeti</span>
                    <div class="mt-3 text-warning fs-3">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Son Eklenen Ürünler -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white p-4 border-0">
            <h5 class="fw-bold mb-0">Son Eklenen Ürünler</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Ürün Adı</th>
                            <th>Stok Miktarı</th>
                            <th>Satış Fiyatı</th>
                            <th>Eklenme Tarihi</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.RecentProducts.Any())
                        {
                            @foreach (var product in Model.RecentProducts)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @product.ProductName
                                    </td>

                                    <td>
                                        @product.StockQuantity
                                    </td>

                                    <td>
                                        @product.SalePrice.ToString("N2") ₺
                                    </td>

                                    <td>
                                        @product.CreatedAt.ToString("dd.MM.yyyy")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    Henüz ürün eklenmemiş.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>

    <!-- Son Stok Hareketleri -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white p-4 border-0">
            <h5 class="fw-bold mb-0">Son Stok Hareketleri</h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Ürün</th>
                            <th>Hareket Türü</th>
                            <th>Miktar</th>
                            <th>Tarih</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.RecentMovements.Any())
                        {
                            @foreach (var movement in Model.RecentMovements)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @movement.ProductName
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @movement.MovementType
                                        </span>
                                    </td>

                                    <td>
                                        @movement.Quantity
                                    </td>

                                    <td>
                                        @movement.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    Henüz stok hareketi bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
