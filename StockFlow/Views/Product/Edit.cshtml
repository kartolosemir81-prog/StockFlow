@model global::StockFlow.Models.Product

@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="container py-4">

    <!-- Başlık -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Ürün Düzenle</h2>
            <p class="text-muted mb-0">
                Mevcut ürün bilgilerini güncelleyin.
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Ürün Listesine Dön
        </a>
    </div>

    <!-- Düzenleme Formu -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Ürün Bilgileri</h5>
        </div>

        <div class="card-body p-4">

            <form asp-controller="Product"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- Ürün Adı -->
                <div class="mb-4">
                    <label asp-for="ProductName"
                           class="form-label fw-semibold">
                        Ürün Adı
                    </label>

                    <input asp-for="ProductName"
                           class="form-control"
                           placeholder="Ürün adını girin" />

                    <span asp-validation-for="ProductName"
                          class="text-danger"></span>
                </div>

                <!-- Barkod -->
                <div class="mb-4">
                    <label asp-for="Barcode"
                           class="form-label fw-semibold">
                        Barkod Numarası
                    </label>

                    <input asp-for="Barcode"
                           class="form-control"
                           placeholder="Barkod numarasını girin" />

                    <span asp-validation-for="Barcode"
                          class="text-danger"></span>
                </div>

                <!-- Fiyatlar -->
                <div class="row">

                    <div class="col-md-6 mb-4">
                        <label asp-for="PurchasePrice"
                               class="form-label fw-semibold">
                            Alış Fiyatı (₺)
                        </label>

                        <input asp-for="PurchasePrice"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="PurchasePrice"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="SalePrice"
                               class="form-label fw-semibold">
                            Satış Fiyatı (₺)
                        </label>

                        <input asp-for="SalePrice"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="SalePrice"
                              class="text-danger"></span>
                    </div>

                </div>

                <!-- Stok -->
                <div class="mb-4">
                    <label asp-for="StockQuantity"
                           class="form-label fw-semibold">
                        Stok Miktarı
                    </label>

                    <input asp-for="StockQuantity"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="StockQuantity"
                          class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <!-- Butonlar -->
                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-light px-4">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Değişiklikleri Kaydet
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
