
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StockFlow</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <div class="app-wrapper">

        <!-- SOL MENÜ -->
        <aside class="sidebar">

            <div class="brand-area">
                <div class="brand-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>
                    <h4>StockFlow</h4>
                    <span>Inventory Management</span>
                </div>
            </div>

            <!-- ANA MENÜ -->
            <div class="sidebar-label">ANA MENÜ</div>

            <nav class="sidebar-nav">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Product" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Genel Bakış / Ürünler</span>
                </a>

                <a asp-controller="Product"
                   asp-action="Create"
                   class="nav-link-custom @(currentController == "Product" && currentAction == "Create" ? "active" : "")">
                    <i class="bi bi-plus-circle"></i>
                    <span>Yeni Ürün Ekle</span>
                </a>

                <a asp-controller="Stock"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Stock" ? "active" : "")">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Stok Yönetimi</span>
                </a>

            </nav>

            <!-- SİSTEM -->
            <div class="sidebar-label mt-4">SİSTEM</div>

            <nav class="sidebar-nav">

                <a asp-controller="Stock"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Stock" ? "active" : "")">
                    <i class="bi bi-clock-history"></i>
                    <span>Stok Hareketleri</span>
                </a>

                <!-- RAPORLAMA -->
                <a asp-controller="Reports"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>Raporlama Merkezi</span>
                </a>

            </nav>

            <!-- ALT MENÜ -->
            <div class="sidebar-bottom">

                <div class="sidebar-user">
                    <div class="user-avatar">SF</div>

                    <div>
                        <strong>StockFlow Admin</strong>
                        <span>Yönetici Paneli</span>
                    </div>
                </div>

            </div>

        </aside>

        <!-- ANA İÇERİK -->
        <main class="main-content">

            <header class="topbar">

                <div>
                    <div class="topbar-heading">
                        Yönetim Paneli
                    </div>

                    <div class="topbar-subtitle">
                        Stok ve ürün yönetim merkezi
                    </div>
                </div>

                <div class="topbar-right">

                    <div class="system-status">
                        <span class="status-dot"></span>
                        Sistem Aktif
                    </div>

                    <div class="topbar-profile">
                        <div class="profile-avatar">A</div>
                    </div>

                </div>

            </header>

            <!-- SAYFA İÇERİĞİ -->
            <section class="page-content">

                @RenderBody()

            </section>

            <!-- FOOTER -->
            <footer class="app-footer">
                <span>© @DateTime.Now.Year StockFlow</span>
                <span>Inventory Management System</span>
            </footer>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
