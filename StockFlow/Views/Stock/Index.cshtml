@model StockFlow.Models.StockIndexViewModel

@{
    ViewData["Title"] = "Stok Yönetimi";
}

<style>
    body {
        background: #f4f6fa;
    }

    .stock-dashboard {
        padding: 25px 10px;
        color: #263247;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

        .dashboard-header h2 {
            font-weight: 750;
            margin-bottom: 5px;
        }

        .dashboard-header p {
            color: #8490a3;
            margin: 0;
        }

    .stat-card {
        background: white;
        border-radius: 14px;
        padding: 22px;
        border: 1px solid #edf0f5;
        height: 100%;
        box-shadow: 0 3px 12px rgba(30, 50, 80, .04);
    }

    .stat-label {
        color: #8490a3;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .stat-value {
        font-size: 29px;
        font-weight: 750;
        color: #263247;
    }

    .stat-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 21px;
    }

    .blue {
        background: #e8f0ff;
        color: #3974db;
    }

    .green {
        background: #e5f8ef;
        color: #15945b;
    }

    .orange {
        background: #fff1df;
        color: #e38b22;
    }

    .red {
        background: #ffebeb;
        color: #df5151;
    }

    .panel {
        background: white;
        border-radius: 14px;
        border: 1px solid #edf0f5;
        padding: 24px;
        box-shadow: 0 3px 12px rgba(30, 50, 80, .04);
        height: 100%;
    }

        .panel h5 {
            font-weight: 700;
            margin-bottom: 22px;
        }

    .form-label {
        font-weight: 600;
        font-size: 14px;
    }

    .form-control, .form-select {
        padding: 11px;
        border-radius: 9px;
        border-color: #e2e7ef;
    }

        .form-control:focus, .form-select:focus {
            border-color: #3974db;
            box-shadow: 0 0 0 3px rgba(57, 116, 219, .1);
        }

    .btn-primary {
        background: #326cce;
        border: none;
        border-radius: 9px;
        padding: 11px 20px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: #2458ae;
        }

    .table {
        vertical-align: middle;
        font-size: 14px;
    }

        .table thead th {
            color: #8490a3;
            font-weight: 600;
            background: #f8f9fc;
            border-bottom: 1px solid #edf0f5;
            padding: 14px;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 15px 14px;
        }

    .movement-badge {
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .entry-badge {
        color: #15945b;
        background: #e5f8ef;
    }

    .exit-badge {
        color: #d94b4b;
        background: #ffebeb;
    }

    .empty-state {
        text-align: center;
        color: #929daf;
        padding: 30px;
    }

    @@media(max-width: 768px) {
        .dashboard-header {
            gap: 15px;
        }

        .panel {
            padding: 17px;
        }
    }
</style>

<div class="container-fluid stock-dashboard">

    <!-- BAŞLIK -->
    <div class="dashboard-header">
        <div>
            <h2>Stok Yönetimi</h2>
            <p>Stok durumunu ve ürün hareketlerini buradan takip edin.</p>
        </div>

        <span class="badge bg-primary p-2">
            STOCKFLOW MANAGEMENT
        </span>
    </div>

    <!-- BİLDİRİMLER -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- İSTATİSTİK KARTLARI -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Toplam Ürün</div>
                        <div class="stat-value">@Model.TotalProducts</div>
                    </div>
                    <div class="stat-icon blue">📦</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Mevcut Stok</div>
                        <div class="stat-value">@Model.TotalStock</div>
                    </div>
                    <div class="stat-icon green">📊</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Toplam Giriş</div>
                        <div class="stat-value">@Model.TotalEntries</div>
                    </div>
                    <div class="stat-icon orange">⬇️</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Toplam Çıkış</div>
                        <div class="stat-value">@Model.TotalExits</div>
                    </div>
                    <div class="stat-icon red">⬆️</div>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <!-- STOK İŞLEM FORMU -->
        <div class="col-lg-4">
            <div class="panel">
                <h5>Yeni Stok İşlemi</h5>

                <form asp-controller="Stock" asp-action="Create" method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ProductId" class="form-label">
                            Ürün Seç
                        </label>

                        <select asp-for="ProductId" class="form-select">
                            <option value="0">Ürün seçiniz</option>

                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Id">
                                    @product.ProductName
                                </option>
                            }
                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MovementType" class="form-label">
                            İşlem Türü
                        </label>

                        <select asp-for="MovementType" class="form-select">
                            <option value="">İşlem seçiniz</option>
                            <option value="Giriş">Stok Girişi</option>
                            <option value="Çıkış">Stok Çıkışı</option>
                        </select>

                        <span asp-validation-for="MovementType"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Quantity" class="form-label">
                            Miktar
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Miktar giriniz" />

                        <span asp-validation-for="Quantity"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">
                            Açıklama
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="İşlem açıklaması..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        + İşlemi Kaydet
                    </button>

                </form>
            </div>
        </div>

        <!-- SON STOK HAREKETLERİ -->
        <div class="col-lg-8">
            <div class="panel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Son Stok Hareketleri</h5>
                    <span class="badge bg-light text-dark">
                        Son 50 işlem
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>İşlem</th>
                                <th>Miktar</th>
                                <th>Açıklama</th>
                                <th>Tarih</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Movements != null && Model.Movements.Any())
                            {
                                @foreach (var movement in Model.Movements)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @(movement.Product?.ProductName ?? "Ürün")
                                        </td>

                                        <td>
                                            @if (movement.MovementType == "Giriş")
                                            {
                                                <span class="movement-badge entry-badge">
                                                    Giriş
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="movement-badge exit-badge">
                                                    Çıkış
                                                </span>
                                            }
                                    </td>

                                    <td class="fw-bold">
                                        @movement.Quantity
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(movement.Description)
                                                                            ? "-"
                                                                            : movement.Description)
                                </td>

                                        <td>
                                            @movement.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                    </tr>
                                                        }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="empty-state">
                                        Henüz stok hareketi bulunmuyor.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <!-- ÜRÜN STOK DURUMU -->
    <div class="panel mt-4">
        <h5>Ürün Stok Durumu</h5>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Ürün Adı</th>
                        <th>Mevcut Stok</th>
                        <th>Stok Durumu</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Products != null && Model.Products.Any())
                    {
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @product.ProductName
                                </td>

                                <td>
                                    @product.StockQuantity
                                </td>

                                <td>
                                    @if (product.StockQuantity <= 5)
                                    {
                                        <span class="badge bg-danger">
                                            Kritik Stok
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Normal
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="empty-state">
                                Henüz ürün eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
